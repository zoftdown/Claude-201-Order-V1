# Django
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=dr89.cloud,localhost
CSRF_TRUSTED_ORIGINS=https://dr89.cloud
FORCE_SCRIPT_NAME=/order

# PostgreSQL
DB_NAME=order_db
DB_USER=order_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# LINE Messaging API (LINE Developers console > Messaging API)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# userId แอดมินที่บอท mention ตอนอ่านใบงานได้ (คั่น comma; ว่าง = "@แอดมิน" ข้อความธรรมดา)
LINE_ADMIN_USER_IDS=
# groupId ของกลุ่ม LINE ที่อนุญาตให้บอททำงาน (คั่น comma) — ว่าง = บล็อกทุกกลุ่ม (fail-closed)
# กลุ่มนอกลิสต์: ไม่ตอบ และถ้าถูกเชิญเข้าจะออกจากกลุ่มเอง · 1:1 chat/room ไม่ทำงานเสมอ
# หา groupId จาก log: journalctl -u order -f | grep line_bot  (ทุก event พิมพ์ groupId=...)
LINE_ALLOWED_GROUP_IDS=

# LLM อ่านเลขออร์เดอร์จากรูป (RunningHub, OpenAI-compatible)
# URL หน้าเว็บระบบนี้ (บอท LINE ใส่ลิงก์ใบงานท้ายข้อความสรุป) ว่าง = ใช้ default prod
ORDER_PUBLIC_BASE=https://dr89.cloud/order
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://llm.runninghub.ai/v1
RUNNINGHUB_MODEL=qwen/qwen3.8-flash-next
# โมเดลสำรองเมื่อโมเดลหลักล่ม (ต้องรองรับ tools + vision บน RunningHub) ว่าง = ไม่มีสำรอง
RUNNINGHUB_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
# ชั้นสำรองที่ 3 คนละผู้ให้บริการ: Anthropic (ใช้เมื่อ RunningHub ล้มทั้ง 2 โมเดล) ว่าง = ไม่มีชั้นนี้
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
